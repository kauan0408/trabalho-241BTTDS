{
	"version": 2,
        "builds": [
        { "src": "/api/index.php", "use": "vercel-php@0.4.0" },
        { "src": "/user_guide/**", "use": "@vercel/static" }
        ],
        "routes": [
        { "src": "/user_guide/(.*)", "dest": "/user_guide/$1" },
        { "src": "/(.*)", "dest": "/api/index.php" }
        ]
}